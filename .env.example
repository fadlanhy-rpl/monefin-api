APP_NAME=MoneFin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────────────
# Development: bisa pakai sqlite (cepat setup) atau pgsql
# Production: wajib PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=monefin
DB_USERNAME=postgres
DB_PASSWORD=

# ─── Session / Cache / Queue ──────────────────────────────────────────────────
# DEVELOPMENT  → bisa tetap database (tidak perlu Redis, langsung jalan)
# PRODUCTION   → wajib ganti ke redis (stateless, performa lebih baik, multi-instance ready)
#
# Cara ganti untuk production:
#   SESSION_DRIVER=redis
#   CACHE_STORE=redis
#   QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# ─── Redis (opsional di development, WAJIB di production) ────────────────────
# Untuk development: biarkan kosong jika tidak pakai Redis
# Untuk production: isi dengan host Redis Anda (bisa via Docker Compose: redis)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ─────────────────────────────────────────────────────────────────────
# Development: pakai 'log' agar OTP/alert muncul di storage/logs/laravel.log tanpa SMTP
# Production: isi dengan SMTP provider (Gmail, Mailgun, Resend, dsb.)
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@monefin.app"
MAIL_FROM_NAME="${APP_NAME}"

# ─── AWS S3 / Object Storage ──────────────────────────────────────────────────
# Isi saat production untuk upload foto profil ke cloud storage (bukan disk lokal)
# agar aplikasi bisa scale ke multi-instance
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# URL Frontend (untuk redirect setelah OAuth callback)
FRONTEND_URL=http://localhost:3000

# ─── AI Feature (BYOK — user memasukkan API key mereka sendiri) ───────────────
# Ini adalah fallback server-side key (opsional, tidak harus diisi)
# Fitur AI utama menggunakan key milik user yang disimpan terenkripsi di DB
KIMI_API_KEY=

VITE_APP_NAME="${APP_NAME}"
