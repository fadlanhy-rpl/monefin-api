# ─── Disable PHP & Script Execution in Uploads Directory ─────────────────
# Mencegah eksekusi webshell, script PHP, atau file executable apapun
# yang diunggah pengguna ke folder profiles/ atau receipts/

<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phar|inc|sh|pl|cgi|py|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Matikan engine PHP jika modul PHP aktif
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Nonaktifkan opsi eksekusi skrip & directory listing
Options -ExecCGI -Indexes
