# ==============================================================================
# MONEFIN BACKEND — PRODUCTION / HYBRID HOSTING ENVIRONMENT TEMPLATE
# ==============================================================================
# Gunakan file ini sebagai acuan pengisian Environment Variables di platform
# hosting Anda (misal: Railway.app, Render.com, atau VPS).
# JANGAN commit file .env yang berisi credential asli ke GitHub!
# ==============================================================================

# ─── 1. Core Application ──────────────────────────────────────────────────────
APP_NAME=MoneFin
APP_ENV=production
# Wajib generate dengan `php artisan key:generate` atau isi dengan key 32-karakter base64
APP_KEY=
# Wajib FALSE di production agar tidak membocorkan error trace & secrets
APP_DEBUG=false
# URL domain backend API publik Anda (contoh: https://api.monefin.web.id atau https://monefin-api.up.railway.app)
APP_URL=https://api.monefin.web.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── 2. Frontend & CORS ───────────────────────────────────────────────────────
# URL domain frontend publik Anda (contoh: https://monefin.web.id atau https://monefin.vercel.app)
# Digunakan untuk CORS whitelist dan redirect setelah OAuth
FRONTEND_URL=https://monefin.vercel.app

# ─── 3. Database (PostgreSQL / Supabase Cloud / Railway Postgres) ─────────────
# MoneFin menggunakan PostgreSQL (bukan MySQL)
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-secure-supabase-password
# Gunakan 'require' untuk koneksi cloud database terenkripsi SSL
DB_SSLMODE=require

# ─── 4. Session, Cache, & Queue ───────────────────────────────────────────────
# Di production, jika menggunakan Redis (disarankan untuk performa & background worker):
# SESSION_DRIVER=redis
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
#
# Atau jika tanpa Redis, gunakan driver database (tabel sudah tersedia):
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# ─── 5. Redis (Opsional — isi jika menggunakan Redis dari Railway/Render) ─────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── 6. Mail (Wajib SMTP asli untuk pengiriman OTP & notifikasi alert) ─────────
# Contoh: Resend, Brevo, SendGrid, atau Gmail App Password
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD="your-app-password"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@monefin.web.id"
MAIL_FROM_NAME="${APP_NAME}"

# ─── 7. Storage (Foto Profil & Lampiran) ──────────────────────────────────────
# 'public' jika server memiliki persistent disk (jangan lupa jalankan `php artisan storage:link`)
# Atau 's3' jika menggunakan AWS S3 / Cloudflare R2 / Supabase Storage
FILESYSTEM_DISK=public

# AWS S3 / Cloudflare R2 (jika FILESYSTEM_DISK=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── 8. Google OAuth2 (Opsional — untuk Login dengan Google) ─────────────────
# Daftarkan Authorized Redirect URI di Google Cloud Console:
# https://api.monefin.web.id/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.monefin.web.id/api/auth/google/callback

# ─── 9. Sanctum API Token Security ───────────────────────────────────────────
# Prefix token untuk deteksi secret scanning
SANCTUM_TOKEN_PREFIX=mnf_
# Token expiration dalam menit (43200 = 30 hari)
SANCTUM_TOKEN_EXPIRATION=43200

# ─── 10. AI Service (Kimi / Moonshot / OpenAI) ───────────────────────────────
# Fallback server-side API Key jika user tidak mengisi key sendiri (BYOK)
KIMI_API_KEY=
