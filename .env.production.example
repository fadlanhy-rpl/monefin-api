APP_NAME=MoneFin
APP_ENV=production
APP_KEY=                    # WAJIB: generate dengan: php artisan key:generate
APP_DEBUG=false             # WAJIB false di production
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=error             # 'error' di production — jangan 'debug'

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres            # Nama service Docker, atau hostname production DB
DB_PORT=5432
DB_DATABASE=monefin
DB_USERNAME=                # Isi dengan kredensial production
DB_PASSWORD=                # Isi dengan password yang kuat

# ─── Session / Cache / Queue ──────────────────────────────────────────────────
# Di production WAJIB Redis untuk stateless (multi-instance ready)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true        # Enkripsi session di production
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis            # Nama service Docker, atau hostname Redis production
REDIS_PASSWORD=             # Password Redis (isi jika Redis diamankan)
REDIS_PORT=6379

# ─── Mail ─────────────────────────────────────────────────────────────────────
# Gunakan transactional mail service (Mailgun, Resend, Postmark, atau SMTP provider)
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── File Storage ─────────────────────────────────────────────────────────────
# Di production, simpan upload ke S3/object storage — bukan disk lokal
# (agar bisa scale ke multi-instance tanpa shared filesystem)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=monefin-uploads
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

FRONTEND_URL=https://yourdomain.com

# ─── Sanctum API Token Security ──────────────────────────────────────────────
# Prefix token untuk GitHub secret scanning — JANGAN dikosongkan di production
SANCTUM_TOKEN_PREFIX=mnf_
# Expiration token dalam menit. null = tidak pernah expired (tidak disarankan production)
# 43200 = 30 hari | 10080 = 7 hari
SANCTUM_TOKEN_EXPIRATION=43200

# ─── AI Feature ───────────────────────────────────────────────────────────────
KIMI_API_KEY=               # Opsional: server-side fallback key

# ─── Horizon Dashboard Protection ────────────────────────────────────────────
# Tambahkan email yang diizinkan akses Horizon di AppServiceProvider
# Gate::define('viewHorizon', fn($user) => in_array($user->email, ['admin@yourdomain.com']));

# ─── BROADCAST ────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log    # Ganti ke 'pusher' atau 'reverb' jika pakai WebSocket

VITE_APP_NAME="${APP_NAME}"
