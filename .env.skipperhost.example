APP_NAME=MoneFin
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sk0010uoic.skipper.my.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Database Supabase Cloud (Aktif & Terhubung) ───
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.itjzgxkwfzrzhxtsynys
DB_PASSWORD=your-supabase-password
DB_SSLMODE=require

# ─── Driver Shared Hosting (Tanpa Redis) ───
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=public

# ─── Mail SMTP ───
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@monefin.web.id"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Frontend & CORS ───
FRONTEND_URL=https://monefin.web.id

# ─── Sanctum Security ───
SANCTUM_TOKEN_PREFIX=mnf_
SANCTUM_TOKEN_EXPIRATION=43200

# ─── Google OAuth2 (Opsional) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sk0010uoic.skipper.my.id/api/auth/google/callback

# ─── AI Service (Kimi Fallback Key) ───
KIMI_API_KEY=
